# MinGW-w64 Qt6 cross build environment (Fedora packages).
# Mirrors the GitHub Actions windows-2022 + MSYS2 MINGW64 smoke stack closely
# enough to reproduce ANTLR/parser and link issues without Actions minutes.
#
# Build:
#   podman build -t fwbuilder-mingw64-qt6 -f docker/Dockerfile.mingw64-qt6-fedora docker/
# Run (from repo root):
#   podman run --rm -it -v "$PWD":/src:Z -w /src fwbuilder-mingw64-qt6 \
#     bash docker/build-mingw64-qt6.sh

FROM docker.io/library/fedora:41

ENV LANG=C.UTF-8 \
    CCACHE_DIR=/src/.ci-ccache-mingw \
    TOOLCHAIN_PREFIX=/usr/x86_64-w64-mingw32/sys-root/mingw

RUN dnf -y upgrade --refresh \
 && dnf -y install \
      autoconf \
      automake \
      bash \
      ccache \
      findutils \
      git \
      libtool \
      make \
      pkgconf \
      pkgconf-pkg-config \
      which \
      mingw64-gcc-c++ \
      mingw64-libxml2 \
      mingw64-libxml2-static \
      mingw64-libxslt \
      mingw64-libxslt-static \
      mingw64-zlib-static \
      mingw64-winpthreads-static \
      mingw64-qt6-qtbase \
      mingw64-qt6-qtsvg \
      mingw64-qt6-qttools \
 && dnf clean all

# qmake6 lives under the mingw sysroot; expose host wrappers too.
ENV PATH="${TOOLCHAIN_PREFIX}/bin:/usr/bin:${PATH}" \
    PKG_CONFIG_PATH="${TOOLCHAIN_PREFIX}/lib/pkgconfig" \
    PKG_CONFIG_LIBDIR="${TOOLCHAIN_PREFIX}/lib/pkgconfig" \
    PKG_CONFIG_SYSROOT_DIR="/"

WORKDIR /src
CMD ["bash"]
