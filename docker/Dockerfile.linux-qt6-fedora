# Native Linux Qt6 build environment for fwbweb / WebUI local work.
# Does not use GitHub Actions.
#
#   podman build -t fwbuilder-linux-qt6 -f docker/Dockerfile.linux-qt6-fedora docker/
#   podman run --rm -v "$PWD":/src:Z -w /src fwbuilder-linux-qt6 bash docker/build-linux-qt6-fwbweb.sh

FROM docker.io/library/fedora:41

ENV LANG=C.UTF-8

RUN dnf -y upgrade --refresh \
 && dnf -y install \
      autoconf \
      automake \
      bash \
      findutils \
      gcc-c++ \
      git \
      libtool \
      libxml2-devel \
      libxslt-devel \
      make \
      pkgconf \
      pkgconf-pkg-config \
      which \
      zlib-devel \
      qt6-qtbase-devel \
      qt6-qttools-devel \
 && dnf clean all

ENV PATH="/usr/lib64/qt6/bin:/usr/bin:${PATH}"

WORKDIR /src
CMD ["bash"]
