## -*- mode: shell-script; -*-
##
## To be able to make changes to the part of configuration created
## from this configlet you need to copy this file to the directory
## fwbuilder/configlets/nftables/ in your home directory and modify it.
## Double "##" comments are removed during processing but single "#"
## comments are be retained and appear in the generated script. Empty
## lines are removed as well.
##
## Configlets support simple macro language with these constructs:
## {{$var}} is variable expansion
## {{if var}} is conditional operator.
##
## This configlet defines commands executed when nftables script is ran
## with command line argument "block". By default it resets nftables
## ruleset using function reset_all and optionally adds backup
## ssh access rules.

block_action() {
    # Replace FWB-owned tables atomically, preserving third-party policies.
    fwb_nft_begin_transaction || return 1
    cat >> "$FWB_NFT_TXN" <<'FWB_NFT_BLOCK'
add table ip fwb_filter
add chain ip fwb_filter INPUT { type filter hook input priority 0; policy drop; }
add chain ip fwb_filter OUTPUT { type filter hook output priority 0; policy drop; }
add chain ip fwb_filter FORWARD { type filter hook forward priority 0; policy drop; }
add table ip6 fwb_filter
add chain ip6 fwb_filter INPUT { type filter hook input priority 0; policy drop; }
add chain ip6 fwb_filter OUTPUT { type filter hook output priority 0; policy drop; }
add chain ip6 fwb_filter FORWARD { type filter hook forward priority 0; policy drop; }
{{if mgmt_access_ipv4}}
add rule ip fwb_filter INPUT ip saddr {{$ssh_management_address_ipv4}} tcp dport 22 ct state { new, established } accept
add rule ip fwb_filter OUTPUT ip daddr {{$ssh_management_address_ipv4}} tcp sport 22 ct state { established, related } accept
{{endif}}
{{if mgmt_access_ipv6}}
add rule ip6 fwb_filter INPUT ip6 saddr {{$ssh_management_address_ipv6}} tcp dport 22 ct state { new, established } accept
add rule ip6 fwb_filter OUTPUT ip6 daddr {{$ssh_management_address_ipv6}} tcp sport 22 ct state { established, related } accept
{{endif}}
FWB_NFT_BLOCK
    fwb_nft_commit_transaction
}
